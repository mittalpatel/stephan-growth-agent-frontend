# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env.local
.env.e2e
.env.development.local
.env.test.local
.env.production.local
# .env.example and .env.e2e.example are safe to commit

# dead code / analysis artifacts
*.bak
*.backup
knip-results.json
unused_files.txt

# test reports
playwright-report/
test-results/

# playwright auth state (contains real session tokens)
e2e/.auth/
e2e/journey/artifacts/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated SBOM (CI uploads it as an artifact)
sbom.json

# Local e2e screenshot analysis output
screenshots/
