# Copy to .env.local and fill in. `npm run setup` does this for you.
#
# Values marked (required) must be set before the app will start.

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# (required) min 32 chars: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Backend API ─────────────────────────────────────────────────────────────
# (required)
# The single source of truth for the backend host. next.config.ts derives the
# backend origin from it and feeds it into the CSP connect-src, CSP img-src, and
# next/image remotePatterns — so switching between localhost, staging, and
# production is a pure env change with no edits to next.config.ts.
#
# next.config.ts is read at build/start time, so restart `next dev` or rebuild
# after changing this. The backend's CORS allow-list must also include this
# frontend's origin.
NEXT_PUBLIC_BACKEND_API=http://localhost:8000

# ── Single sign-on (optional) ───────────────────────────────────────────────
# Empty by default — no "Continue with..." button renders and no provider is
# registered with NextAuth. To add one (generic OIDC — Google, Okta, Auth0,
# Azure AD, ...):
#   1. List its name in both OIDC_PROVIDERS (server-only) and
#      NEXT_PUBLIC_SOCIAL_PROVIDERS (drives which button(s) render) — keep them
#      in sync, since the second is only for the button label/list, not auth.
#   2. Set OIDC_<NAME>_ISSUER / OIDC_<NAME>_CLIENT_ID / OIDC_<NAME>_CLIENT_SECRET
#      (server-only — never NEXT_PUBLIC_, the secret must never reach the
#      browser bundle).
#   3. Set the matching OIDC_<NAME>_ISSUER and OIDC_<NAME>_CLIENT_ID on the
#      BACKEND too (see its own .env.example) — no client secret there, it
#      only verifies the id_token, it never talks to the IdP directly.
# See src/lib/auth/oidcProviders.ts.
OIDC_PROVIDERS=
NEXT_PUBLIC_SOCIAL_PROVIDERS=
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
#
# GitHub is plain OAuth2, not OIDC (no id_token/JWKS), so it's registered via
# NextAuth's built-in provider instead of the OIDC_<NAME>_* scheme above — its
# own well-known var names, and it still only needs listing in
# NEXT_PUBLIC_SOCIAL_PROVIDERS to get a button. See authOptions.ts.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Monitoring (optional) ───────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Server-side only — never prefix with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# ── Sign-up guard (optional) ────────────────────────────────────────────────
# Signup is invite-only; this is an additional shared secret the invite must
# carry before the backend will accept it.
SIGNUP_SECRET_TOKEN=

# ── Playwright E2E ──────────────────────────────────────────────────────────
# Credentials live in .env.e2e (gitignored). Copy .env.e2e.example → .env.e2e
# and fill in the per-role logins. PLAYWRIGHT_BASE_URL is read from there too.
