# ── Playwright E2E environment ──────────────────────────────────────────────
# Copy to .env.e2e and fill in. Never commit .env.e2e — it holds real logins.
#
# The accounts below map to the roles seeded by the backend's
# `manage.py seed_rbac` (see apps/rbac/seed_data.py):
#
#   Admin      every widget permission, including export
#   Member     widget view/manage/execute — deliberately NOT export
#   Read Only  widget view and preferences view only
#
# The suite needs more than one because the assertions worth having are about
# what a user *cannot* do. A single admin account can only ever prove the happy
# path, and the authorization bugs worth catching all live in the other cases.

PLAYWRIGHT_BASE_URL=http://localhost:3000

# ── Backend prerequisite: raise the auth throttle ───────────────────────────
# The backend defaults to AUTH_THROTTLE_RATE=5/min, IP-keyed. A full run of the
# `rbac` project logs in ~20+ times from one IP, so it throttles itself: later
# tests fail sitting on /login and look like flaky assertions rather than 429s.
# Set this in the BACKEND's .env before running (it is env-configurable for
# exactly this reason — see config/env.py):
#
#   AUTH_THROTTLE_RATE=200/min
#
# Production keeps the 5/min default.

# ── Full access (the seeded `Admin` role) ───────────────────────────────────
# Used by: e2e/authenticated/**  ·  storage state: e2e/.auth/user.json
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# ── Read-only (the seeded `Read Only` role) ─────────────────────────────────
# Used by: e2e/roles/read-only.spec.ts  ·  storage state: e2e/.auth/read-only.json
E2E_READ_ONLY_EMAIL=
E2E_READ_ONLY_PASSWORD=

# ── No role assigned ────────────────────────────────────────────────────────
# Authenticates successfully and then has access to nothing, so it must land on
# /no-role rather than a broken page. Create one by registering a user and
# assigning no role.
# Used by: e2e/roles/no-access.spec.ts  ·  storage state: e2e/.auth/no-access.json
E2E_NO_ACCESS_EMAIL=
E2E_NO_ACCESS_PASSWORD=

# ── Platform superuser (impersonation flow) ─────────────────────────────────
# Not a member of either demo org. Seeded by the backend's `seed_demo_users`
# as `demo.superadmin@example.com` / `Demo@12345`.
# Used by: e2e/authenticated/rbac/impersonation.spec.ts (positive flow only —
# self-skips without these set).
E2E_SUPERUSER_EMAIL=
E2E_SUPERUSER_PASSWORD=

# ── Phase 2 auth-hardening journey ──────────────────────────────────────────
# Creates its own account via public signup — no credentials needed here.
# Reads OTP/notification emails from the backend's own log instead of a real
# inbox; see e2e/journey/README.md for the one prerequisite (console email
# backend) and this path's default.
# Used by: e2e/journey/phase2-auth-journey.spec.ts
E2E_BACKEND_LOG_PATH=../enterprise-backend-template/logs/celery_worker.log
